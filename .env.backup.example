# ─── Database Backup ─────────────────────────────────────────────────────────
# Asosiy .env dagi DB_* o'zgaruvchilari backup scriptlari tomonidan ham ishlatiladi.
# Quyidagi qiymatlarni .env ga qo'shing.
#
# PROJECT_NAME — loyiha root papka nomidan avtomatik olinadi (jas)
# LOCAL_RETENTION_DAYS=7 / REMOTE_RETENTION_DAYS=30 — kodda static

# Lokal backup papkasi (default: loyiha/backups)
# BACKUP_DIR=/var/backups/jas

# Log papkasi (default: loyiha/logs)
# LOG_DIR=/var/log/jas

# rclone remote va papka (Google Drive)
# rclone config orqali "gdrive" remote yarating
# default: gdrive:<project-folder>/backups
RCLONE_REMOTE=gdrive:jas/backups
RCLONE_ENABLED=true

# Diskda kamida qancha bo'sh joy bo'lishi kerak (MB)
MIN_FREE_MB=500

# Docker Compose servis nomlari
# DB_SERVICE=db
# APP_SERVICE=app

# Telegram bildirishnomalar (backup success/failure)
# Mavjud BOT_TOKEN ishlatiladi. Group/channel ga botni admin qiling.
TELEGRAM_ENABLED=true
BACKUP_CHANNEL_ID=-100xxxxxxxxx

# Cron (install-backup-cron.sh uchun, default: har kuni 02:00)
# CRON_SCHEDULE=0 2 * * *
# CRON_LOG=/path/to/logs/cron-backup.log
