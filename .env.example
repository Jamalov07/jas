# PDF invoice logo: jas | kas. Docker: docker-compose `PDF_LOGO_BRAND` (default u yerda jas).
# Agar PDF_LOGO_BRAND bo‘lmasa: legacy `APP=jas` → jas logo, aks holda kas.
PDF_LOGO_BRAND=jas

# app (Nest listen). Docker: HOST=0.0.0.0 PORT=3000 — docker-compose sets these.
PORT=
HOST=
# optional overrides (if set, used instead of HOST/PORT above)
# APP_HOST=
# APP_PORT=

#db
DATABASE_URL=

#jwt
REFRESH_TOKEN_TIME=
REFRESH_TOKEN_KEY=
ACCESS_TOKEN_TIME=
ACCESS_TOKEN_KEY=

#bot (optional — bo‘lmasa Telegram bot va kanal xabarlari o‘chiriladi)
# BOT_TOKEN=
# SELLING_CHANNEL_ID=
# PAYMENT_CHANNEL_ID=

# ─── Database Backup (see docs/BACKUP.md and .env.backup.example) ─────────────
# PROJECT_NAME = root papka nomi (avtomatik: jas)
# Retention: local 7 kun / remote 30 kun (static)
# RCLONE_REMOTE=gdrive:jas/backups
# RCLONE_ENABLED=true
# TELEGRAM_ENABLED=true
# BACKUP_CHANNEL_ID=-100xxxxxxxxx

# e2e (optional — enables `test/api-smoke.e2e-spec.ts` staff token checks)
# E2E_STAFF_PHONE=
# E2E_STAFF_PASSWORD=
